# Desktop: Gigabyte B550 AORUS PRO AX, Ryzen (Zen 2), Radeon

## Processor
# CONFIG_CPU_SUP_INTEL is not set
# CONFIG_X86_MCE_INTEL is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
CONFIG_PERF_EVENTS_AMD_BRS=y
CONFIG_X86_CPUID=y
CONFIG_X86_CPU_RESCTRL=y
CONFIG_AMD_MEM_ENCRYPT=y
# CONFIG_SCHED_CLUSTER is not set
CONFIG_SENSORS_K10TEMP=m
CONFIG_EDAC_DECODE_MCE=m
CONFIG_KVM_AMD=m
# CONFIG_KVM_AMD_SEV is not set
# CONFIG_SEV_GUEST is not set
CONFIG_HZ_1000=y
CONFIG_PHYSICAL_ALIGN=0x1000000

## Power and thermal
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_POWERCAP=y
CONFIG_THERMAL_NETLINK=y
# CONFIG_ACPI_PCC is not set

## Platform
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_PINCTRL_AMD=y
CONFIG_I2C_PIIX4=m
CONFIG_AMD_IOMMU=y
# CONFIG_INTEL_MEI is not set
# The PSP/CCP crypto coprocessor.
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_HW_RANDOM=y
# CONFIG_VIRTIO_MENU is not set
# Board sensors: gigabyte_wmi provides the temperatures.
# TODO: the Super-I/O is an ITE IT8688E, so nct6683 never binds (consider dropping).
CONFIG_GIGABYTE_WMI=m
CONFIG_SENSORS_NCT6683=m
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y

## Graphics and audio
CONFIG_DRM_AMDGPU=m
# ROCm uses HMM, which needs DEVICE_PRIVATE, ZONE_DEVICE and memory hotplug.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_HSA_AMD=y
CONFIG_DEVICE_PRIVATE=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# Realtek ALC1220 (the ALC882 family)
CONFIG_SND_HDA_CODEC_REALTEK=m
# CONFIG_SND_HDA_CODEC_ALC260 is not set
# CONFIG_SND_HDA_CODEC_ALC262 is not set
# CONFIG_SND_HDA_CODEC_ALC268 is not set
# CONFIG_SND_HDA_CODEC_ALC269 is not set
# CONFIG_SND_HDA_CODEC_ALC662 is not set
# CONFIG_SND_HDA_CODEC_ALC680 is not set
# CONFIG_SND_HDA_CODEC_ALC861 is not set
# CONFIG_SND_HDA_CODEC_ALC861VD is not set
# CONFIG_SND_HDA_CODEC_ALC880 is not set
# CONFIG_SND_HDA_CODEC_HDMI_INTEL is not set
# CONFIG_SND_X86 is not set

## Input
# USB keyboards only.
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_SERIO_I8042 is not set

## Storage
CONFIG_TMPFS=y

## Networking
# RTL8125 2.5GbE and the MT7921 wifi.
CONFIG_R8169=m
CONFIG_MT7921E=m
# TODO: an Intel gigabit NIC, is there one in this machine?
CONFIG_IGB=m
