# Framework Laptop 13, 12th gen Intel (i7-1280P, Alder Lake-P)

## Processor
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_X86_MCE_AMD is not set
CONFIG_INTEL_TURBO_MAX_3=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=m
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_CSTATE=m
CONFIG_SENSORS_CORETEMP=m
# mitigations=off is on the cmdline anyway.
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set
# CONFIG_MITIGATION_RFDS is not set
CONFIG_KVM_INTEL=m

## Battery life: a slower tick, offloaded and batched RCU callbacks
CONFIG_HZ_300=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

## Power and thermal (thermald, TLP)
CONFIG_INTEL_IDLE=y
CONFIG_ACPI_PROCESSOR_AGGREGATOR=m
CONFIG_ACPI_DPTF=y
# CONFIG_DPTF_POWER is not set
# CONFIG_DPTF_PCH_FIVR is not set
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INTEL_TCC_COOLING=m
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_PM_DEVFREQ_EVENT=y
# S0ix residency and package telemetry.
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_VSEC=m

## Platform
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_INTEL_IDMA64=m
CONFIG_DW_DMAC=m
CONFIG_I2C_I801=m
# i2c-dev, for ddcutil and i2c-tools.
CONFIG_I2C_CHARDEV=y
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_HDCP=m
# CONFIG_WMI_BMOF is not set
# The Framework's embedded controller plus framework-laptop-kmod
CONFIG_CHROME_PLATFORMS=y
CONFIG_CROS_EC=m
CONFIG_CROS_EC_LPC=m
# CONFIG_CROS_EC_LIGHTBAR is not set
# CONFIG_CHARGER_CROS_PCHG is not set
# The IOMMU is off by default, but the firmware asks for Thunderbolt DMA protection,
# which enables the IOMMU anyway.
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_SVM=y
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set
# CONFIG_INTEL_IOMMU_SCALABLE_MODE_DEFAULT_ON is not set
CONFIG_PCI_MSI=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_TCG_TIS_I2C=y
CONFIG_TRUSTED_KEYS=y

## USB-C and Thunderbolt
CONFIG_USB=y
CONFIG_USB_XHCI_PCI_RENESAS=y
CONFIG_USB4=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_TYPEC_TBT_ALTMODE=m
CONFIG_USB_ROLE_SWITCH=m

## Graphics and audio
CONFIG_DRM_I915=m
# The Tempo/IDT 92HD95 codec. SOF isn't needed without DMICs or SoundWire.
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_INTEL_HDMI_SILENT_STREAM=y
# CONFIG_SND_HDA_CODEC_HDMI_ATI is not set
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_INPUT_BEEP_MODE=0
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_DUMMY=m
# CONFIG_SND_SEQ_UMP is not set

## Input and sensors
# The touchpad.
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m
# The ambient light sensor.
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_ACPI_ALS=m
CONFIG_IIO=m
CONFIG_LEDS_TRIGGER_CPU=y

## Storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_BSGLIB=y
CONFIG_BLK_DEV_INTEGRITY=y
CONFIG_BLK_DEV_ZONED=y
CONFIG_BLK_CGROUP_IOPRIO=y
CONFIG_ZRAM_WRITEBACK=y

## Networking
# No built-in ethernet: USB tethering from a phone.
# CONFIG_ETHERNET is not set
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_NET_RNDIS_HOST=m
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
CONFIG_PACKET_DIAG=m
# MD4 for MSCHAPv2 (EAP-PEAP) and NTLM.
CONFIG_CRYPTO_MD4=m

## Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_SERIAL_8250_EXAR is not set
# CONFIG_SERIAL_8250_MOXA_PCIE is not set
# CONFIG_SERIAL_8250_LPSS is not set
# CONFIG_SERIAL_8250_PERICOM is not set

## Boot and misc
CONFIG_BOOT_CONFIG=y
CONFIG_EFI_BOOTLOADER_CONTROL=y
CONFIG_CGROUP_RDMA=y
CONFIG_MODULE_FORCE_UNLOAD=y

## Debugging
CONFIG_LOCK_EVENT_COUNTS=y
CONFIG_BPF_KPROBE_OVERRIDE=y
