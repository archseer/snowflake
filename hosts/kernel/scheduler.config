# Preemption, timers and sched_ext.

CONFIG_PREEMPT=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
# sched_ext only checks for an expired time slice on the tick, so a faster tick
# lets scx_lavd enforce short slices. With tickless idle, only busy CPUs tick.
CONFIG_HZ_1000=y
CONFIG_SCHED_AUTOGROUP=y

## sched_ext (services.scx, scx_lavd)
CONFIG_SCHED_CLASS_EXT=y
# scx_lavd reads per-CPU variables such as __preempt_count
CONFIG_KALLSYMS_ALL=y
# BPF trampolines attach to the function entry hooks this adds. fentry/fexit programs
# and systemd's BPF LSM programs use them, and scx_lavd traces futex calls with them.
CONFIG_FUNCTION_TRACER=y
# BPF schedulers need the BPF JIT and BTF type information
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# scx reads the running config from /proc/config.gz
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
