## Security modules
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
# systemd's RestrictFileSystems= needs the BPF LSM.
CONFIG_BPF_LSM=y
# matches the lsm= that NixOS puts on the cmdline
CONFIG_LSM="landlock,yama,bpf"
# CONFIG_INTEGRITY is not set
# Lockdown and module signing are off because they only matter with Secure Boot.

## Memory safety
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
# Not merging slab caches of different types makes use-after-free bugs harder to
# exploit.
# CONFIG_SLAB_MERGE_DEFAULT is not set
# CONFIG_COMPAT_BRK is not set
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
# Cheap runtime checks that turn corruption into an oops instead of an exploit.
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_LIST=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_WX=y
CONFIG_UBSAN=y
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set

## Interfaces
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_DEVMEM is not set
# Mount devtmpfs nosuid,noexec.
CONFIG_DEVTMPFS_SAFE=y
# userfaultfd stays off. Exploits often use it, and only QEMU post-copy migration
# and CRIU lazy restore need it.
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_BLK_DEV_WRITE_MOUNTED is not set
# /proc/pid/mem uses the default, FORCE_PTRACE, so writes that ignore page
# permissions only work from a ptrace-attached process such as a debugger.
# Built, but off until enabled with the kernel.sysrq sysctl.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
