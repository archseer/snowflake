## Tracing and probes (perf, bpftrace, ftrace)
CONFIG_PROFILING=y
CONFIG_KPROBES=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_FUNCTION_GRAPH_RETVAL=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_STACK_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_HIST_TRIGGERS=y
CONFIG_FUNCTION_ERROR_INJECTION=y
# CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED is not set
# CONFIG_RCU_TRACE is not set
CONFIG_SCHEDSTATS=y

## Diagnostics
CONFIG_DYNAMIC_DEBUG=y
# CONFIG_DEBUG_MISC is not set
CONFIG_STRIP_ASM_SYMS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_RCU_CPU_STALL_TIMEOUT=60
CONFIG_DEBUG_MEMORY_INIT=y
CONFIG_DEBUG_BOOT_PARAMS=y
# CONFIG_X86_VERBOSE_BOOTUP is not set
# CONFIG_X86_DEBUG_FPU is not set
CONFIG_VALIDATE_FS_PARSER=y
CONFIG_DM_DEBUG=y
# /proc/kcore, for live kernel debugging (drgn, crash).
CONFIG_PROC_KCORE=y
# KFENCE is built but disabled at boot (sample interval 0); enable with kfence.sample_interval=.
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=0
# PM_TRACE_RTC only stores suspend/resume traces in the RTC when pm_trace is
# enabled at runtime (which scrambles the clock).
CONFIG_PM_DEBUG=y
CONFIG_PM_TRACE_RTC=y
