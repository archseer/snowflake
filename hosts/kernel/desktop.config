## Graphics (the GPU driver is per host)
CONFIG_DRM=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
# simpledrm drives the firmware framebuffer until the GPU driver loads.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
# CONFIG_FB_DEVICE is not set
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

## Sound (the HDA codec is per host)
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SEQUENCER=m
# Timer and dummy client for MIDI sequencer apps.
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_DUMMY=m
# CONFIG_SND_DRIVERS is not set
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_PATCH_LOADER=y
# hdajackretask needs hwdep. The codec beep is built but off by default.
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_INPUT_BEEP_MODE=0
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1
CONFIG_SND_HDA_CODEC_HDMI=m
# CONFIG_SND_HDA_CODEC_HDMI_SIMPLE is not set
# CONFIG_SND_HDA_CODEC_HDMI_NVIDIA is not set
# CONFIG_SND_HDA_CODEC_HDMI_NVIDIA_MCP is not set
# CONFIG_SND_HDA_CODEC_HDMI_TEGRA is not set
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_USB_AUDIO_MIDI_V2=y

## Cameras (UVC webcams)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_MEDIA_CEC_SUPPORT=y

## Input
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
# CONFIG_MOUSE_PS2 is not set
# CONFIG_SERIO_SERPORT is not set
# ydotool and interception-tools inject input events through uinput.
CONFIG_INPUT_UINPUT=m
# FIDO2 keys such as the YubiKey are accessed through hidraw.
CONFIG_HIDRAW=y
# BlueZ uses uhid for Bluetooth input devices.
CONFIG_UHID=m
CONFIG_USB_HIDDEV=y
CONFIG_HID_BATTERY_STRENGTH=y

## Gaming
# Wine/Proton NT synchronization primitives.
CONFIG_NTSYNC=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=m
# Xbox controllers.
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
# Force feedback for HID game controllers.
CONFIG_HID_PID=y
# Switch Pro controller and Joy-Cons.
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
