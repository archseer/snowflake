#!/usr/bin/env bash
# Commands for a host's Kconfig fragments (see hosts/kernel/default.nix).
#
#   scripts/kconfig HOST lint           list fragment lines that are Kconfig defaults
#                                       or implied by other settings. Run it after a
#                                       kernel update.
#   scripts/kconfig HOST menuconfig     open menuconfig on the full config and print
#                                       the changes as fragment lines, next to the
#                                       file that sets each symbol.
#   scripts/kconfig HOST savedefconfig  print the minimal config for the fragments.
#   scripts/kconfig HOST show           print the path of the generated config.
#
# The script doesn't edit the fragments, because they hold comments and grouping.
set -euo pipefail

host=${1:?usage: scripts/kconfig HOST lint|menuconfig|savedefconfig|show}
cmd=${2:-lint}
flake=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
kernel="$flake#nixosConfigurations.$host.config.boot.kernelPackages.kernel"

config=$(nix build --no-link --print-out-paths "$kernel.configfile")
if [ "$cmd" = show ]; then
  echo "$config"
  exit
fi

mapfile -t fragments < <(nix eval --json "$kernel.configfile.fragments" | tr -d '[]"' | tr ',' '\n')
src=$(nix build --no-link --print-out-paths "$kernel.src")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/src" "$work/out"
tar -xf "$src" -C "$work/src" --strip-components=1
cp "$config" "$work/out/.config"
chmod u+w "$work/out/.config"

# The config derivation's build environment, plus ncurses for menuconfig.
env_expr="let
  f = builtins.getFlake (toString $flake);
  c = f.nixosConfigurations.$host.config.boot.kernelPackages.kernel.configfile;
  p = f.nixosConfigurations.$host.pkgs;
in c.overrideAttrs (o: {
  nativeBuildInputs = o.nativeBuildInputs ++ [p.buildPackages.pkg-config];
  buildInputs = [p.ncurses];
})"
kmake() {
  nix develop --impure --expr "$env_expr" --command \
    make -s -C "$work/src" O="$work/out" "$@"
}

settings() { grep -hE '^(CONFIG_[A-Za-z0-9_]+=|# CONFIG_[A-Za-z0-9_]+ is not set$)' "$@" || true; }
symbol() { sed -E 's/^# (CONFIG_[A-Za-z0-9_]+) is not set$/\1/; s/=.*//'; }
# A fragment's repo-relative name from its store path (/nix/store/<hash>-base.config).
name() { local b=${1##*/}; echo "${b#*-}"; }

case $cmd in
savedefconfig)
  kmake savedefconfig >/dev/null
  cat "$work/out/defconfig"
  ;;
lint)
  kmake savedefconfig >/dev/null
  found=
  for f in "${fragments[@]}"; do
    redundant=$(settings "$f" | grep -vxFf "$work/out/defconfig" || true)
    if [ -n "$redundant" ]; then
      found=1
      echo "== $(name "$f"): default or implied"
      echo "$redundant"
    fi
  done
  [ -n "$found" ] || echo "no redundant lines"
  ;;
menuconfig)
  kmake savedefconfig >/dev/null
  mv "$work/out/defconfig" "$work/before"
  kmake menuconfig
  kmake savedefconfig >/dev/null
  changes=$(diff "$work/before" "$work/out/defconfig" | grep '^[<>]' || true)
  if [ -z "$changes" ]; then
    echo "no changes"
    exit
  fi
  echo "Fragment changes (- remove, + add) and the file that sets each symbol:"
  while read -r dir line; do
    sym=$(echo "$line" | symbol)
    where=""
    for f in "${fragments[@]}"; do
      if settings "$f" | symbol | grep -qx "$sym"; then where=$(name "$f"); fi
    done
    [ "$dir" = "<" ] && sign=- || sign=+
    printf '%s %-55s %s\n' "$sign" "$line" "${where:-(new)}"
  done <<<"$changes"
  ;;
*)
  echo "unknown command: $cmd" >&2
  exit 1
  ;;
esac
